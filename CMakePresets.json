{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/core",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.work/tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/dependencies",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.work/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CANOPY_ENABLE_SANITIZERS": "OFF"
      },
      "environment": {
        "VCPKG_DISABLE_METRICS": "1"
      }
    },
    {
      "name": "native-debug",
      "inherits": "native-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "native-release",
      "inherits": "native-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "native-asan-ubsan",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/.build/core-sanitized",
      "cacheVariables": { "CANOPY_ENABLE_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "native-asan-ubsan", "configurePreset": "native-asan-ubsan" }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true } },
    { "name": "native-release", "configurePreset": "native-release", "output": { "outputOnFailure": true } },
    { "name": "native-asan-ubsan", "configurePreset": "native-asan-ubsan", "output": { "outputOnFailure": true } }
  ]
}
