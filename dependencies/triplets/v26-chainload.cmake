set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "$ENV{CANOPY_LINUX_TOOLCHAIN_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "$ENV{CANOPY_LINUX_TOOLCHAIN_ROOT}/bin/clang++")
set(CMAKE_SYSROOT "$ENV{CANOPY_LINUX_SYSROOT}")
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++ -nostdinc++ -isystem \"$ENV{CANOPY_LINUX_SYSROOT}/include\" -isystem \"$ENV{CANOPY_LINUX_LIBCXX_INCLUDE}\"")
set(CANOPY_LINUX_LIBCXX_LINK "-nodefaultlibs \"$ENV{CANOPY_LINUX_LIBCXX_LIBDIR}/libc++.a\" \"$ENV{CANOPY_LINUX_LIBCXX_LIBDIR}/libc++abi.a\" -lm -lc -lpthread -lgcc_s -lgcc")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${CANOPY_LINUX_LIBCXX_LINK}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CANOPY_LINUX_LIBCXX_LINK}")
